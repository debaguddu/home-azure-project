{
	"name": "PL_Child2_Landing_To_Bronze_Raw",
	"properties": {
		"description": "Child Pipeline 2: Processes landed pipe-delimited CSV data from Landing container into Bronze Parquet files (Full load) or executes Databricks Job to perform DQ checks and upsert Delta tables in Bronze layer (Incremental), returning updated watermark value.",
		"activities": [
			{
				"name": "Lookup_Log_Child2_Start",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC [dbo].[sp_LogPipelineStart] @BatchID = ''', pipeline().parameters.BatchID, ''', @PipelineRunID = ''', pipeline().RunId, ''', @PipelineName = ''PL_Child2_Landing_To_Bronze_Raw'', @TableID = ', string(pipeline().parameters.TableID), ', @TableName = ''', pipeline().parameters.SourceTableName, ''', @LoadType = ''', pipeline().parameters.LoadType, '''; SELECT ''', pipeline().RunId, ''' AS RunId;')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ASQL_Generic",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "dbo",
							"TableName": "PipelineExecutionLog"
						}
					}
				}
			},
			{
				"name": "If_Is_Incremental",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup_Log_Child2_Start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"typeProperties": {
					"expression": {
						"value": "@equals(toUpper(pipeline().parameters.LoadType), 'INCREMENTAL')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Databricks_Job_Incremental",
							"type": "DatabricksJob",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"jobId": {
									"value": "@pipeline().parameters.DatabricksJobId",
									"type": "Expression"
								},
								"jobParameters": {
									"source_table_name": {
										"value": "@pipeline().parameters.SourceTableName",
										"type": "Expression"
									},
									"folder_date": {
										"value": "@formatDateTime(utcnow(), 'yyyy/MM/dd')",
										"type": "Expression"
									},
									"landing_container": {
										"value": "@pipeline().parameters.TargetContainerLanding",
										"type": "Expression"
									},
									"bronze_container": {
										"value": "@pipeline().parameters.TargetContainerBronze",
										"type": "Expression"
									},
									"raw_container": {
										"value": "@pipeline().parameters.TargetContainerBronze",
										"type": "Expression"
									},
									"storage_account_name": "azureprojectdevadls01",
									"watermark_column": {
										"value": "@pipeline().parameters.WatermarkColumn",
										"type": "Expression"
									},
									"primary_keys": {
										"value": "@pipeline().parameters.PrimaryKeys",
										"type": "Expression"
									},
									"mandatory_columns": {
										"value": "@pipeline().parameters.MandatoryColumns",
										"type": "Expression"
									},
									"volume_catalog": "landing_catalog",
									"volume_schema": "source_sql",
									"volume_name": {
										"value": "@concat('vol_', toLower(pipeline().parameters.SourceTableName))",
										"type": "Expression"
									},
									"target_catalog": "bronze_catalog",
									"target_schema": "raw_data",
									"folder_prefix": "home/datalake/claims",
									"file_name": {
										"value": "@pipeline().parameters.FileName",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_ADB_HOME_01",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Web_Get_Run_Details",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Databricks_Job_Incremental",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(pipeline().parameters.DatabricksWorkspaceUrl, '/api/2.1/jobs/runs/get?run_id=', string(activity('Databricks_Job_Incremental').output.runId))",
									"type": "Expression"
								},
								"headers": {
									"Content-Type": "application/json"
								},
								"authentication": {
									"type": "MSI",
									"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
								}
							}
						},
						{
							"name": "Web_Get_Run_Output",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Web_Get_Run_Details",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"url": {
									"value": "@concat(pipeline().parameters.DatabricksWorkspaceUrl, '/api/2.1/jobs/runs/get-output?run_id=', string(activity('Web_Get_Run_Details').output.tasks[0].run_id))",
									"type": "Expression"
								},
								"headers": {
									"Content-Type": "application/json"
								},
								"authentication": {
									"type": "MSI",
									"resource": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
								}
							}
						},
						{
							"name": "Lookup_Update_Watermark",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "Web_Get_Run_Output",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.00:05:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "@concat('EXEC [dbo].[sp_UpdateWatermark] @TableID = ', string(pipeline().parameters.TableID), ', @NewWatermarkValue = ''', string(coalesce(json(activity('Web_Get_Run_Output').output.notebook_output.result).max_watermark_value, '')), '''; SELECT ''WatermarkUpdated'' AS Status;')",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_ASQL_Generic",
									"type": "DatasetReference",
									"parameters": {
										"SchemaName": "dbo",
										"TableName": "WatermarkTable"
									}
								}
							}
						},
						{
							"name": "SetVariable_RowsCopied_Incremental",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Web_Get_Run_Output",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "RowsCopied",
								"value": {
									"value": "@string(coalesce(json(activity('Web_Get_Run_Output').output.notebook_output.result).rows_processed, '0'))",
									"type": "Expression"
								}
							}
						}
					],
					"ifFalseActivities": [
						{
							"name": "Copy_Landing_To_Bronze_Full",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFileName": {
											"value": "@if(empty(pipeline().parameters.FileName), '*.csv', pipeline().parameters.FileName)",
											"type": "Expression"
										},
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_ADLS_Landing_CSV",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.TargetContainerLanding",
											"type": "Expression"
										},
										"Directory": {
											"value": "@concat('home/datalake/claims/', pipeline().parameters.SourceTableName, '/', formatDateTime(utcnow(), 'yyyy/MM/dd'))",
											"type": "Expression"
										},
										"FileName": {
											"value": "@if(empty(pipeline().parameters.FileName), '*', pipeline().parameters.FileName)",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Bronze_Parquet",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.TargetContainerBronze",
											"type": "Expression"
										},
										"Directory": {
											"value": "@concat('home/datalake/claims/', pipeline().parameters.SourceTableName)",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(pipeline().parameters.SourceTableName, '.parquet')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SetVariable_RowsCopied_Full",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy_Landing_To_Bronze_Full",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "RowsCopied",
								"value": {
									"value": "@string(activity('Copy_Landing_To_Bronze_Full').output.rowsCopied)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Lookup_Log_Child2_End_Success",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "If_Is_Incremental",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC [dbo].[sp_LogPipelineEnd] @BatchID = ''', pipeline().parameters.BatchID, ''', @PipelineRunID = ''', pipeline().RunId, ''', @Status = ''Success'', @RowsCopied = ', coalesce(variables('RowsCopied'), '0'), ', @ErrorMessage = NULL; SELECT ''Success'' AS Status;')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ASQL_Generic",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "dbo",
							"TableName": "PipelineExecutionLog"
						}
					}
				}
			},
			{
				"name": "Lookup_Log_Child2_End_Failed",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "If_Is_Incremental",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC [dbo].[sp_LogPipelineEnd] @BatchID = ''', pipeline().parameters.BatchID, ''', @PipelineRunID = ''', pipeline().RunId, ''', @Status = ''Failed'', @RowsCopied = NULL, @ErrorMessage = ''Child 2 Landing to Bronze/Raw Failed''; SELECT ''Failed'' AS Status;')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ASQL_Generic",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "dbo",
							"TableName": "PipelineExecutionLog"
						}
					}
				}
			}
		],
		"parameters": {
			"BatchID": {
				"type": "String"
			},
			"TableID": {
				"type": "Int"
			},
			"SourceSchema": {
				"type": "String",
				"defaultValue": "dbo"
			},
			"SourceTableName": {
				"type": "String"
			},
			"LoadType": {
				"type": "String",
				"defaultValue": "Incremental"
			},
			"WatermarkColumn": {
				"type": "String",
				"defaultValue": "ModifiedDate"
			},
			"TargetContainerLanding": {
				"type": "String",
				"defaultValue": "landing"
			},
			"TargetContainerBronze": {
				"type": "String",
				"defaultValue": "bronze"
			},
			"PrimaryKeys": {
				"type": "String",
				"defaultValue": ""
			},
			"MandatoryColumns": {
				"type": "String",
				"defaultValue": ""
			},
			"SendAlert": {
				"type": "String",
				"defaultValue": "Y"
			},
			"DatabricksJobId": {
				"type": "String",
				"defaultValue": "202308513646851"
			},
			"DatabricksWorkspaceUrl": {
				"type": "String",
				"defaultValue": "https://adb-7405612959366844.4.azuredatabricks.net"
			},
			"FileName": {
				"type": "String",
				"defaultValue": ""
			}
		},
		"variables": {
			"RowsCopied": {
				"type": "String",
				"defaultValue": "0"
			}
		},
		"annotations": []
	}
}