{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-azureproject-dev-01"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_TriggerName": {
            "type": "string",
            "defaultValue": "Daily_Trigger"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_LoadType": {
            "type": "string",
            "defaultValue": "Incremental"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksJobId": {
            "type": "string",
            "defaultValue": "202308513646851"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksSyncJobId": {
            "type": "string",
            "defaultValue": "308693633677595"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksBronzeToSilverJobId": {
            "type": "string",
            "defaultValue": "466350837846976"
        },
        "TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksSilverToGoldJobId": {
            "type": "string",
            "defaultValue": "1076549010168499"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/TR_Medallion_Daily_Incremental_Load')]",
            "type": "Microsoft.DataFactory/factories/triggers",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Daily Incremental Load trigger for PL_Master_Medallion_End_To_End scheduled at 16:45 IST.",
                "annotations": [
                    "Medallion",
                    "IncrementalLoad",
                    "Production"
                ],
                "runtimeState": "Started",
                "pipelines": [
                    {
                        "pipelineReference": {
                            "referenceName": "PL_Master_Medallion_End_To_End",
                            "type": "PipelineReference"
                        },
                        "parameters": {
                            "TriggerName": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_TriggerName')]",
                            "LoadType": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_LoadType')]",
                            "DatabricksJobId": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksJobId')]",
                            "DatabricksSyncJobId": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksSyncJobId')]",
                            "DatabricksBronzeToSilverJobId": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksBronzeToSilverJobId')]",
                            "DatabricksSilverToGoldJobId": "[parameters('TR_Medallion_Daily_Incremental_Load_properties_PL_Master_Medallion_End_To_End_parameters_DatabricksSilverToGoldJobId')]"
                        }
                    }
                ],
                "type": "ScheduleTrigger",
                "typeProperties": {
                    "recurrence": {
                        "frequency": "Day",
                        "interval": 1,
                        "startTime": "2026-11-21T16:45:00",
                        "timeZone": "India Standard Time",
                        "schedule": {
                            "minutes": [
                                45
                            ],
                            "hours": [
                                16
                            ]
                        }
                    }
                }
            },
            "dependsOn": []
        }
    ]
}